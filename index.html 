
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THINQ OTT</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b12;color:white;font-family:Arial,sans-serif}
header{padding:18px 5%;display:flex;align-items:center;justify-content:space-between;background:#10131e;position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:900;color:#ff3155}
.logo span{color:white}
nav a{color:#ddd;text-decoration:none;margin-left:12px;font-size:13px}
.hero{padding:60px 6%;background:linear-gradient(90deg,#090b12,#452037);min-height:290px}
.hero small{color:#ff5470;letter-spacing:3px}
.hero h1{font-size:clamp(32px,7vw,45px);margin:14px 0}
.hero p{color:#ccc;max-width:450px;line-height:1.6}
button{border:0;border-radius:7px;padding:12px 20px;background:#ff3155;color:white;font-weight:bold;cursor:pointer}
.search{padding:20px 5%;display:flex;gap:10px}
.search input{flex:1;min-width:0;background:#191d29;color:white;border:1px solid #34394a;border-radius:8px;padding:14px;font-size:15px}
.categories{padding:0 5% 15px;display:flex;gap:9px;flex-wrap:wrap}
.categories button{background:#202536;color:#ddd;padding:9px 16px}
.categories button.active{background:#ff3155;color:white}
section{padding:12px 5% 28px}
h2{font-size:21px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:17px}
.card{background:#171b27;border-radius:10px;overflow:hidden}
.poster{height:190px;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;font-size:21px;font-weight:bold;background:linear-gradient(145deg,#263c66,#a52e54)}
.card:nth-child(3n) .poster{background:linear-gradient(145deg,#164e50,#6c3980)}
.card:nth-child(3n+1) .poster{background:linear-gradient(145deg,#693b24,#b34b35)}
.info{padding:12px}
.info h3{font-size:15px;margin:4px 0}
.info p{font-size:12px;color:#aaa}
.info button{width:100%;margin-top:5px;padding:10px 5px;font-size:12px}
.info .trailer{background:#30394c;margin-top:7px}
.empty{display:none;color:#aaa;padding:15px}
#player{display:none;position:fixed;inset:0;background:#000;z-index:20;padding:15px}
#playerContent{height:85vh;display:flex;align-items:center;justify-content:center}
#playerContent iframe,#playerContent video{width:100%;height:100%;border:0}
#player h2{font-size:17px}
#player button{margin-top:10px}
footer{text-align:center;padding:30px;color:#999;background:#10131e}
@media(max-width:500px){nav a{margin-left:7px;font-size:12px}.hero{padding-top:45px}.poster{height:175px}}
</style>
</head>
<body>

<header>
<div class="logo">THINQ <span>OTT</span></div>
<nav>
<a href="#home">Home</a>
<a href="#movies">Movies</a>
<a href="#series">Series</a>
</nav>
</header>

<div class="hero" id="home">
<small>YOUR ENTERTAINMENT WORLD</small>
<h1>Welcome to THINQ OTT</h1>
<p>Discover movies, web series and entertainment in one place.</p>
<button onclick="document.getElementById('movies').scrollIntoView({behavior:'smooth'})">Explore Now ▶</button>
</div>

<div class="search">
<input id="searchBox" type="search" placeholder="🔍 Search movies and series..." oninput="render()">
</div>

<div class="categories">
<button class="active" onclick="setCategory('All',this)">All</button>
<button onclick="setCategory('Movie',this)">Movies</button>
<button onclick="setCategory('Series',this)">Web Series</button>
<button onclick="setCategory('Action',this)">Action</button>
<button onclick="setCategory('Drama',this)">Drama</button>
<button onclick="setCategory('Comedy',this)">Comedy</button>
<button onclick="setCategory('Malayalam',this)">Malayalam</button>
</div>

<section id="movies">
<h2>⭐ Featured Movies</h2>
<div class="grid" id="featuredGrid"></div>
</section>

<section>
<h2>🔥 Latest Movies</h2>
<div class="grid" id="movieGrid"></div>
<p class="empty" id="empty">No titles found. Try another search.</p>
</section>

<section id="series">
<h2>🎬 Explore Entertainment</h2>
<p style="color:#aaa;line-height:1.6">Your destination for movies and web series. More content can be added here as you obtain streaming rights.</p>
</section>

<div id="player">
<h2 id="playingTitle">Now Playing</h2>
<div id="playerContent"></div>
<button onclick="closePlayer()">✕ Close Player</button>
</div>

<footer>
<div class="logo">THINQ OTT</div>
<p>Made with ❤️ by Sudarsanan K R</p>
<p>© 2026 THINQ OTT. All rights reserved.</p>
</footer>

<script>
const titles=[
{name:"The Great Adventure",type:"Movie",genre:"Action",year:"2026",featured:true},
{name:"Mystery World",type:"Movie",genre:"Drama",year:"2026",featured:true},
{name:"Laugh Out Loud",type:"Movie",genre:"Comedy",year:"2025"},
{name:"Malayalam Stories",type:"Movie",genre:"Malayalam",year:"2026"},
{name:"Wild Planet",type:"Series",genre:"Drama",year:"2025"},
{name:"Action Heroes",type:"Movie",genre:"Action",year:"2026"},
{name:"Dream Journey",type:"Series",genre:"Drama",year:"2026"},
{name:"Fun Unlimited",type:"Movie",genre:"Comedy",year:"2025"}
];

let category="All";

function card(t,i){
return `<div class="card">
<div class="poster">${t.name}</div>
<div class="info">
<h3>${t.name}</h3>
<p>${t.type} · ${t.genre} · ${t.year}</p>
<button onclick="playMovie(${i})">▶ Watch</button>
<button class="trailer" onclick="showTrailer(${i})">🎬 Trailer</button>
</div></div>`;
}

function render(){
const q=document.getElementById("searchBox").value.toLowerCase();
const list=titles.map((t,i)=>({...t,index:i})).filter(t=>
(category==="All"||t.type===category||t.genre===category)&&
(t.name.toLowerCase().includes(q)||t.genre.toLowerCase().includes(q))
);
document.getElementById("movieGrid").innerHTML=list.map(t=>card(t,t.index)).join("");
document.getElementById("empty").style.display=list.length?"none":"block";

const featured=titles.map((t,i)=>({...t,index:i})).filter(t=>t.featured);
document.getElementById("featuredGrid").innerHTML=featured.map(t=>card(t,t.index)).join("");
}

function setCategory(c,btn){
category=c;
document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
btn.classList.add("active");
render();
}

function showTrailer(i){
const t=titles[i];
document.getElementById("playingTitle").textContent=t.name+" - Trailer";
document.getElementById("playerContent").innerHTML=
`<div style="text-align:center;color:white">
<h2>🎬 ${t.name}</h2>
<p>Search for the official trailer on YouTube.</p>
<button onclick="window.open('https://www.youtube.com/results?search_query='+encodeURIComponent('${t.name} official trailer'),'_blank')">▶ Watch Trailer on YouTube</button>
</div>`;
document.getElementById("player").style.display="block";
}

function playMovie(i){
const t=titles[i];
document.getElementById("playingTitle").textContent=t.name;
document.getElementById("playerContent").innerHTML=
`<div style="text-align:center;color:white">
<h2>${t.name}</h2>
<p>Demo player. Add your own licensed movie video URL to stream this title.</p>
</div>`;
document.getElementById("player").style.display="block";
}

function closePlayer(){
document.getElementById("playerContent").innerHTML="";
document.getElementById("player").style.display="none";
}

render();
</script>
</body>
</html>
