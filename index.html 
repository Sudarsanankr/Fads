<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FADS - Movies & Entertainment</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080b13;color:white;font-family:Arial,sans-serif}
header{background:#111827;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.logo{font-size:30px;font-weight:900;color:#ff3155}
.logo span{color:white}
nav a{color:white;text-decoration:none;margin-left:12px;font-size:13px}
.hero{padding:65px 7%;background:linear-gradient(110deg,#101827,#6b183c);min-height:300px}
.hero small{color:#ff5470;letter-spacing:3px}
.hero h1{font-size:42px;margin:15px 0}
.hero p{color:#ddd;max-width:420px;line-height:1.6}
button{border:0;border-radius:7px;padding:12px 18px;font-weight:bold;cursor:pointer}
.primary{background:#ff3155;color:white}
.secondary{background:#263247;color:white}
.search{padding:25px 5%;display:flex;gap:10px}
.search input{flex:1;min-width:0;padding:14px;border-radius:8px;border:1px solid #39445a;background:#151e2d;color:white}
h2{padding:0 5%;margin-top:25px}
.movies{display:grid;grid-template-columns:repeat(2,1fr);gap:15px;padding:15px 5%}
.card{background:#151e2d;border-radius:10px;overflow:hidden}
.poster{height:190px;display:flex;align-items:center;justify-content:center;font-size:45px;background:linear-gradient(140deg,#303b57,#852c50)}
.info{padding:12px}
.info h3{margin:5px 0}
.info p{font-size:12px;color:#aaa}
.info button{width:100%;margin-top:5px}
#player{display:none;position:fixed;inset:0;background:#000;z-index:20;align-items:center;justify-content:center;flex-direction:column;padding:15px}
#video{width:100%;max-height:75vh}
footer{text-align:center;padding:30px;color:#8993a5}
@media(min-width:650px){.movies{grid-template-columns:repeat(4,1fr)}.poster{height:260px}}
</style>
</head>
<body>

<header>
<div class="logo">FADS<span>.</span></div>
<nav>
<a href="#home">Home</a>
<a href="#featured">Movies</a>
<a href="#latest">Latest</a>
</nav>
</header>

<section class="hero" id="home">
<small>WELCOME TO FADS</small>
<h1>Unlimited Movies.<br>One Destination.</h1>
<p>Discover movies, explore trailers and enjoy entertainment with FADS.</p>
<button class="primary" onclick="document.getElementById('featured').scrollIntoView()">Explore Movies</button>
</section>

<div class="search">
<input id="search" placeholder="Search movies..." oninput="renderMovies()">
</div>

<h2 id="featured">⭐ Featured Movies</h2>
<div class="movies" id="featuredMovies"></div>

<h2 id="latest">🎬 Latest Movies</h2>
<div class="movies" id="latestMovies"></div>

<div id="player">
<button class="primary" onclick="closePlayer()">✕ Close Player</button>
<video id="video" controls playsinline></video>
<p id="playerMessage" style="color:#aaa">Choose a video source to play.</p>
</div>

<footer>© 2026 FADS Entertainment | Proudly made by Sudarsanan K R</footer>

<script>
const movies=[
{title:"Movie One",year:"2026",genre:"Action",emoji:"🎬",featured:true},
{title:"Movie Two",year:"2026",genre:"Drama",emoji:"🎭",featured:true},
{title:"Movie Three",year:"2025",genre:"Adventure",emoji:"🌄",featured:false},
{title:"Movie Four",year:"2025",genre:"Comedy",emoji:"😂",featured:false}
];

function renderMovies(){
const q=document.getElementById("search").value.toLowerCase();
const filtered=movies.filter(m=>m.title.toLowerCase().includes(q)||m.genre.toLowerCase().includes(q));
document.getElementById("featuredMovies").innerHTML=filtered.filter(m=>m.featured).map(cardHTML).join("");
document.getElementById("latestMovies").innerHTML=filtered.filter(m=>!m.featured).map(cardHTML).join("");
}
function cardHTML(m){
return `<div class="card">
<div class="poster">${m.emoji}</div>
<div class="info">
<h3>${m.title}</h3>
<p>${m.year} • ${m.genre}</p>
<button class="primary" onclick="trailer('${m.title}')">▶ Watch Trailer</button>
</div></div>`;
}
function trailer(title){
window.open("https://www.youtube.com/results?search_query="+encodeURIComponent(title+" official trailer"),"_blank");
}
function closePlayer(){
document.getElementById("video").pause();
document.getElementById("video").src="";
document.getElementById("player").style.display="none";
}
renderMovies();
</script>
</body>
</html>