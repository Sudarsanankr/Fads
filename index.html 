 <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THINQ OTT</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080b13;color:white;font-family:Arial,sans-serif}
header{background:#111827;padding:18px 5%;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:5}
.logo{font-size:27px;font-weight:900;color:#ff3155}
.logo span{color:white}
nav a{color:white;text-decoration:none;margin-left:12px;font-size:13px}
.hero{padding:65px 7%;background:linear-gradient(100deg,#101827,#6b183c);min-height:300px}
.hero small{color:#ff5470;letter-spacing:3px}
.hero h1{font-size:42px;margin:15px 0}
.hero p{color:#ddd;max-width:420px;line-height:1.6}
button{border:0;border-radius:7px;padding:12px 18px;background:#ff3155;color:white;font-weight:bold;cursor:pointer}
.search{padding:20px 5%}
.search input{width:100%;padding:15px;border:1px solid #444;border-radius:8px;background:#171e2b;color:white;font-size:16px}
h2{margin:25px 5% 15px}
.categories{display:flex;gap:10px;overflow-x:auto;padding:5px 5% 15px}
.categories button{white-space:nowrap;background:#202a3a}
.categories button.active{background:#ff3155}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;padding:0 5%}
.movie{background:#151c29;border-radius:9px;overflow:hidden;cursor:pointer}
.movie img{width:100%;height:165px;object-fit:cover}
.movie-info{padding:10px}
.movie-info h3{font-size:14px;margin:3px 0 7px}
.movie-info p{font-size:12px;color:#aaa;margin:0 0 9px}
.movie-info button{padding:8px;font-size:12px;width:100%}
.player{display:none;position:fixed;inset:0;background:#000;z-index:20;align-items:center;justify-content:center;flex-direction:column;padding:15px}
.player video{width:100%;max-height:75vh}
.player button{margin-top:15px}
footer{text-align:center;color:#888;padding:35px 10px}
@media(max-width:500px){
.grid{grid-template-columns:repeat(2,1fr)}
.movie img{height:190px}
.hero h1{font-size:34px}
nav a{font-size:11px;margin-left:6px}
}
</style>
</head>
<body>

<header>
<div class="logo">THINQ<span> OTT</span></div>
<nav>
<a href="#home">Home</a>
<a href="#movies">Movies</a>
<a href="#latest">Latest</a>
</nav>
</header>

<section class="hero" id="home">
<small>WELCOME TO THINQ OTT</small>
<h1>Unlimited Entertainment</h1>
<p>Discover movies, explore new stories and enjoy entertainment in one place.</p>
<button onclick="document.getElementById('movies').scrollIntoView()">▶ Explore Movies</button>
</section>

<div class="search">
<input id="search" type="search" placeholder="🔍 Search your favourite movie..." oninput="render()">
</div>

<h2>🎭 Browse Categories</h2>
<div class="categories" id="categories">
<button class="active" onclick="filter('All',this)">All</button>
<button onclick="filter('Action',this)">Action</button>
<button onclick="filter('Drama',this)">Drama</button>
<button onclick="filter('Comedy',this)">Comedy</button>
<button onclick="filter('Thriller',this)">Thriller</button>
<button onclick="filter('Adventure',this)">Adventure</button>
</div>

<h2>⭐ Featured Movies</h2>
<div class="grid" id="featured"></div>

<h2 id="latest">🆕 Latest Movies</h2>
<div class="grid" id="movies"></div>

<div class="player" id="player">
<video id="video" controls playsinline></video>
<button onclick="closePlayer()">✕ Close Player</button>
</div>

<footer>
<div class="logo">THINQ OTT</div>
<p>Your Entertainment. Your World.</p>
<p>© 2026 THINQ OTT</p>
</footer>

<script>
const data=[
{
name:"Adventure World",cat:"Adventure",year:"2026",
img:"https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=600",
video:"https://www.w3schools.com/html/mov_bbb.mp4"
},
{
name:"Action Force",cat:"Action",year:"2026",
img:"https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=600",
video:"https://www.w3schools.com/html/movie.mp4"
},
{
name:"Mystery Night",cat:"Thriller",year:"2025",
img:"https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=600",
video:"https://www.w3schools.com/html/mov_bbb.mp4"
},
{
name:"Dream Stories",cat:"Drama",year:"2026",
img:"https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=600",
video:"https://www.w3schools.com/html/movie.mp4"
},
{
name:"Funny Days",cat:"Comedy",year:"2025",
img:"https://images.unsplash.com/photo-1485846234645-a62644f84728?w=600",
video:"https://www.w3schools.com/html/mov_bbb.mp4"
},
{
name:"Wild Planet",cat:"Adventure",year:"2026",
img:"https://images.unsplash.com/photo-1472396961693-142e6e269027?w=600",
video:"https://www.w3schools.com/html/movie.mp4"
}
];

let selected="All";

function card(m){
return `<div class="movie">
<img src="${m.img}" alt="${m.name}">
<div class="movie-info">
<h3>${m.name}</h3>
<p>${m.cat} • ${m.year}</p>
<button onclick="playMovie('${m.video}')">▶ Watch Trailer</button>
</div></div>`;
}

function render(){
let q=document.getElementById("search").value.toLowerCase();
let list=data.filter(m=>
(selected==="All"||m.cat===selected)&&
m.name.toLowerCase().includes(q)
);
document.getElementById("movies").innerHTML=list.map(card).join("");
document.getElementById("featured").innerHTML=data.slice(0,3).map(card).join("");
}

function filter(cat,btn){
selected=cat;
document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
btn.classList.add("active");
render();
}

function playMovie(url){
let p=document.getElementById("player");
let v=document.getElementById("video");
p.style.display="flex";
v.src=url;
v.play();
if(v.requestFullscreen)v.requestFullscreen().catch(()=>{});
}

function closePlayer(){
let v=document.getElementById("video");
v.pause();
v.src="";
document.getElementById("player").style.display="none";
}

render();
</script>
</body>
</html>  