
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>THINQ OTT</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090b12;color:white;font-family:Arial,sans-serif}
header{padding:18px 5%;display:flex;align-items:center;justify-content:space-between;background:#10131e;position:sticky;top:0;z-index:5}
.logo{font-size:25px;font-weight:900;color:#ff3155;letter-spacing:1px}
.logo span{color:white}
nav a{color:#ddd;text-decoration:none;margin-left:15px;font-size:14px}
.hero{padding:65px 6%;background:linear-gradient(90deg,#111522,#24152b,#111522);min-height:290px}
.hero small{color:#ff5470;letter-spacing:3px}
.hero h1{font-size:42px;margin:14px 0}
.hero p{color:#ccc;max-width:450px;line-height:1.6}
button{border:0;border-radius:7px;padding:12px 20px;background:#ff3155;color:white;font-weight:bold;cursor:pointer}
.search{padding:20px 5%;display:flex;gap:10px}
.search input{flex:1;min-width:0;background:#191d29;color:white;border:1px solid #34394a;border-radius:8px;padding:14px;font-size:15px}
.categories{padding:0 5% 15px;display:flex;gap:9px;flex-wrap:wrap}
.categories button{background:#202536;color:#ddd;padding:9px 16px}
.categories button.active{background:#ff3155;color:white}
section{padding:12px 5% 28px}
h2{font-size:21px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:17px}
.card{background:#171b27;border-radius:10px;overflow:hidden}
.poster{height:190px;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;font-size:21px;font-weight:bold;background:linear-gradient(145deg,#263c66,#a52e54)}
.card:nth-child(3n) .poster{background:linear-gradient(145deg,#164e50,#6c3980)}
.card:nth-child(3n+1) .poster{background:linear-gradient(145deg,#633d24,#b83c56)}
.info{padding:12px}
.info h3{font-size:15px;margin:0 0 7px}
.info p{font-size:12px;color:#aaa;margin:0 0 12px}
.info button{width:100%;padding:9px}
.player{display:none;padding:20px 5%;background:#111522}
.player video{width:100%;max-height:420px;background:#000;border-radius:10px}
.player h2{margin-top:10px}
footer{text-align:center;padding:30px;color:#888;background:#10131e;font-size:13px}
.empty{color:#aaa;padding:20px;display:none}
@media(max-width:500px){.hero h1{font-size:32px}.hero{padding-top:45px}nav a{margin-left:7px;font-size:12px}.poster{height:165px}}
</style>
</head>
<body>
<header>
<div class="logo">THINQ <span>OTT</span></div>
<nav><a href="#home">Home</a><a href="#movies">Movies</a><a href="#series">Series</a></nav>
</header>

<div class="hero" id="home">
<small>YOUR ENTERTAINMENT WORLD</small>
<h1>Welcome to THINQ OTT</h1>
<p>Discover movies, web series and entertainment in one place.</p>
<button onclick="document.getElementById('movies').scrollIntoView({behavior:'smooth'})">Explore Now ▶</button>
</div>

<div class="search">
<input id="searchBox" type="search" placeholder="Search movies and series..." oninput="filterMovies()">
</div>

<div class="categories">
<button class="active" onclick="setCategory('All',this)">All</button>
<button onclick="setCategory('Movie',this)">Movies</button>
<button onclick="setCategory('Series',this)">Web Series</button>
<button onclick="setCategory('Action',this)">Action</button>
<button onclick="setCategory('Drama',this)">Drama</button>
</div>

<section id="movies">
<h2>🔥 Trending Now</h2>
<div class="grid" id="movieGrid"></div>
<p class="empty" id="empty">No titles found. Try another search.</p>
</section>

<div class="player" id="player">
<h2 id="playingTitle">Now Playing</h2>
<video id="videoPlayer" controls playsinline preload="metadata">
<source src="https://archive.org/download/BigBuckBunny_124/Content/big_buck_bunny_720p_surround.mp4" type="video/mp4">
Your browser does not support video playback.
</video>
<p style="color:#aaa;font-size:13px">Demo video for testing the player. Replace with videos you own or are licensed to stream.</p>
<button onclick="closePlayer()">Close Player</button>
</div>

<section id="series">
<h2>🎬 Explore Entertainment</h2>
<p style="color:#aaa;line-height:1.6">Your destination for movies and web series. More content can be added here as you obtain streaming rights.</p>
</section>

<footer>
<div class="logo">THINQ OTT</div>
<p>Made with ❤️ by Sudarsanan K R</p>
<p>© 2026 THINQ OTT. All rights reserved.</p>
</footer>

<script>
const titles=[
{name:"The Adventure",type:"Movie",genre:"Action",year:"2026",art:"ADVENTURE"},
{name:"Mystery World",type:"Series",genre:"Drama",year:"2026",art:"MYSTERY"},
{name:"The Journey",type:"Movie",genre:"Drama",year:"2025",art:"JOURNEY"},
{name:"Action Force",type:"Movie",genre:"Action",year:"2025",art:"ACTION FORCE"},
{name:"Dream Stories",type:"Series",genre:"Drama",year:"2026",art:"DREAM STORIES"},
{name:"Wild Planet",type:"Movie",genre:"Action",year:"2025",art:"WILD PLANET"}
];
let category="All";
function render(){
const q=document.getElementById("searchBox").value.toLowerCase();
const list=titles.filter(t=>(category==="All"||t.type===category||t.genre===category)&&
(t.name.toLowerCase().includes(q)||t.genre.toLowerCase().includes(q)));
document.getElementById("movieGrid").innerHTML=list.map(t=>`
<div class="card">
<div class="poster">${t.art}</div>
<div class="info">
<h3>${t.name}</h3>
<p>${t.type} • ${t.genre} • ${t.year}</p>
<button onclick="playDemo('${t.name}')">▶ Watch Demo</button>
</div></div>`).join("");
document.getElementById("empty").style.display=list.length?"none":"block";
}
function filterMovies(){render()}
function setCategory(c,btn){
category=c;
document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
btn.classList.add("active");
render();
}
function playDemo(name){
document.getElementById("playingTitle").textContent=name+" — Demo Player";
document.getElementById("player").style.display="block";
document.getElementById("player").scrollIntoView({behavior:"smooth"});
document.getElementById("videoPlayer").load();
}
function closePlayer(){
const v=document.getElementById("videoPlayer");
v.pause();
document.getElementById("player").style.display="none";
}
render();
</script>
</body>
</html>
