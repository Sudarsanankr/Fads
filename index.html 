
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FADS - Movies & Entertainment</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#080b13;
 color:white;
 font-family:Arial,sans-serif;
}
header{
 background:#111827;
 padding:18px 5%;
 display:flex;
 justify-content:space-between;
 align-items:center;
 position:sticky;
 top:0;
 z-index:5;
}
.logo{
 font-size:30px;
 font-weight:900;
 color:#ff3155;
}
.logo span{color:white}
nav a{
 color:white;
 text-decoration:none;
 margin-left:12px;
 font-size:13px;
}
.hero{
 padding:65px 7%;
 background:linear-gradient(110deg,#101827,#6b183c);
 min-height:300px;
}
.hero small{
 color:#ff5470;
 letter-spacing:3px;
}
.hero h1{
 font-size:42px;
 margin:15px 0;
}
.hero p{
 color:#ddd;
 max-width:420px;
 line-height:1.6;
}
button{
 border:0;
 border-radius:7px;
 padding:12px 18px;
 font-weight:bold;
 cursor:pointer;
}
.primary{
 background:#ff3155;
 color:white;
}
.secondary{
 background:#263247;
 color:white;
}
.search{
 padding:25px 5%;
 display:flex;
 gap:10px;
}
.search input{
 flex:1;
 min-width:0;
 padding:14px;
 border-radius:7px;
 border:1px solid #444;
 background:#111827;
 color:white;
 font-size:16px;
}
section.movies-section{padding:15px 5%}
.movies-section h2{font-size:23px}
.movies{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:15px;
}
.card{
 background:#111827;
 border-radius:10px;
 overflow:hidden;
 border:1px solid #263247;
}
.poster{
 height:190px;
 display:flex;
 justify-content:center;
 align-items:center;
 font-size:65px;
 background:linear-gradient(140deg,#263247,#6b183c);
}
.info{padding:12px}
.info h3{margin:5px 0}
.info p{color:#aaa;font-size:13px}
.info button{width:100%;margin-top:7px}
.player{
 display:none;
 position:fixed;
 inset:0;
 background:#000;
 z-index:20;
 align-items:center;
 justify-content:center;
 flex-direction:column;
 padding:15px;
}
#video{
 width:100%;
 max-height:75vh;
}
footer{
 text-align:center;
 padding:30px;
 color:#8993a5;
}
@media(min-width:650px){
 .movies{grid-template-columns:repeat(4,1fr)}
 .poster{height:260px}
}
</style>
</head>

<body>

<header>
 <div class="logo">FADS<span>.</span></div>
 <nav>
  <a href="#home">Home</a>
  <a href="#featured">Movies</a>
  <a href="#latest">Latest</a>
 </nav>
</header>

<section class="hero" id="home">
 <small>WELCOME TO FADS</small>
 <h1>Unlimited Movies.<br>One Destination.</h1>
 <p>Discover movies, explore trailers and enjoy entertainment with FADS.</p>
 <button class="primary"
 onclick="document.getElementById('featured').scrollIntoView()">
 Explore Movies
 </button>
</section>

<div class="search">
 <input id="search" placeholder="Search movies..." oninput="renderMovies()">
</div>

<section class="movies-section" id="featured">
 <h2>⭐ Featured Movies</h2>
 <div class="movies" id="featuredMovies"></div>
</section>

<section class="movies-section" id="latest">
 <h2>🎬 Latest Movies</h2>
 <div class="movies" id="latestMovies"></div>
</section>

<div class="player" id="player">
 <button class="secondary" onclick="closePlayer()">✕ Close</button>
 <video id="video" controls playsinline></video>
</div>

<footer>
 <p>FADS - Movies & Entertainment</p>
 <p>Proudly made by Sudarsanan K R</p>
</footer>

<script>
const movies=[
 {title:"Avatar",year:"2022",genre:"Adventure",emoji:"🌌",featured:true},
 {title:"The Lion King",year:"2019",genre:"Animation",emoji:"🦁",featured:true},
 {title:"Spider-Man",year:"2023",genre:"Action",emoji:"🕷️",featured:true},
 {title:"Frozen",year:"2023",genre:"Animation",emoji:"❄️",featured:true},
 {title:"Interstellar",year:"2023",genre:"Sci-Fi",emoji:"🚀",featured:false},
 {title:"Jungle Adventure",year:"2024",genre:"Adventure",emoji:"🌴",featured:false},
 {title:"The Batman",year:"2022",genre:"Action",emoji:"🦇",featured:false},
 {title:"Coco",year:"2023",genre:"Animation",emoji:"🎸",featured:false}
];

function cardHTML(m){
 return `
 <div class="card">
  <div class="poster">${m.emoji}</div>
  <div class="info">
   <h3>${m.title}</h3>
   <p>${m.year} • ${m.genre}</p>
   <button class="primary" onclick="trailer('${m.title}')">
    ▶ Watch Trailer
   </button>
  </div>
 </div>`;
}

function renderMovies(){
 const q=document.getElementById("search").value.toLowerCase();
 const filtered=movies.filter(m=>
  m.title.toLowerCase().includes(q) ||
  m.genre.toLowerCase().includes(q)
 );
 document.getElementById("featuredMovies").innerHTML=
  filtered.filter(m=>m.featured).map(cardHTML).join("");
 document.getElementById("latestMovies").innerHTML=
  filtered.filter(m=>!m.featured).map(cardHTML).join("");
}

function trailer(title){
 window.open(
  "https://www.youtube.com/results?search_query="+
  encodeURIComponent(title+" official trailer"),
  "_blank"
 );
}

function closePlayer(){
 const video=document.getElementById("video");
 video.pause();
 video.src="";
 document.getElementById("player").style.display="none";
}

renderMovies();
</script>

</body>
</html>
