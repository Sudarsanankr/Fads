<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="strict-origin-when-cross-origin">
<title>FADS - Movies & Entertainment</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080b13;color:white;font-family:Arial,sans-serif}
header{background:#111827;padding:17px 5%;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:5}
.logo{font-size:30px;font-weight:900;color:#ff3155}
.logo span{color:white}
nav a{color:white;text-decoration:none;margin-left:12px;font-size:14px}
.hero{padding:52px 7%;background:linear-gradient(110deg,#241629,#6b183c);min-height:250px}
.hero small{color:#ff8297;letter-spacing:2px}
.hero h1{font-size:36px}
.hero p{color:#ddd;line-height:1.6;max-width:520px}
button{border:0;border-radius:8px;padding:13px 17px;background:#ff3155;color:white;font-weight:bold;cursor:pointer}
button.secondary{background:#202b3d}
button:disabled{opacity:.55}
.search{display:flex;gap:9px;padding:20px 5%;flex-wrap:wrap}
.search input{flex:1;min-width:180px}
input{padding:14px;border:1px solid #394152;border-radius:8px;background:#151d2b;color:white;font-size:16px}
section{padding:16px 5%}
h2{font-size:23px}
.categories{display:flex;gap:9px;flex-wrap:wrap}
.categories button{background:#202b3d}
.categories button.active{background:#ff3155}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:15px}
.movie{background:#151d2b;border-radius:10px;overflow:hidden}
.movie img{width:100%;aspect-ratio:16/9;object-fit:cover;background:#222}
.movie-info{padding:10px}
.movie h3{font-size:14px;line-height:1.4}
.movie p{font-size:12px;color:#aaa}
.movie-info button{padding:9px 10px;font-size:12px}
.player{width:100%;aspect-ratio:16/9;background:black;border:0;border-radius:9px}
#playerBox{display:none}
#status{color:#ffb7c5;line-height:1.5;padding:8px 0}
.status-ok{color:#8ee6ad!important}
.status-error{color:#ff9eae!important}
.note{color:#b9c0ce;font-size:13px;line-height:1.55}
.modal{display:none;position:fixed;inset:0;background:#000e;z-index:10;overflow:auto;padding:16px}
.modal-content{max-width:600px;margin:28px auto;background:#151d2b;padding:20px;border:1px solid #394152;border-radius:13px}
.modal-content input{width:100%;margin:8px 0 12px}
.modal-actions{display:flex;gap:9px;flex-wrap:wrap}
.close{float:right;background:#394152}
.help{background:#202b3d;padding:12px;border-radius:9px;margin-top:14px}
.help ol{padding-left:20px;line-height:1.6}
.footer{text-align:center;padding:30px;color:#aaa;background:#111827;margin-top:30px}
@media(max-width:520px){header{padding:14px 4%}nav a{margin-left:7px;font-size:12px}}
</style>
</head>
<body>

<header>
<div class="logo">FADS<span>.</span></div>
<nav>
<a href="#home">Home</a>
<a href="#movies">Movies</a>
<a href="#watchlist">Watchlist</a>
</nav>
</header>

<div class="hero" id="home">
<small>MOVIES • ENTERTAINMENT • DISCOVERY</small>
<h1>Discover Your Next Movie</h1>
<p>Search movie trailers and official videos across Malayalam, Tamil, Telugu, Hindi and English.</p>
<button onclick="document.getElementById('searchInput').focus()">Explore Now</button>
</div>

<div class="search">
<input id="searchInput" placeholder="Search movies, trailers, actors...">
<button id="searchBtn" onclick="searchVideos()">SEARCH</button>
<button onclick="openSettings()">⚙ API SETTINGS</button>
</div>

<section>
<div class="categories">
<button class="active" onclick="chooseCategory(this,'')">All</button>
<button onclick="chooseCategory(this,'Malayalam movie official trailer')">Malayalam</button>
<button onclick="chooseCategory(this,'Tamil movie official trailer')">Tamil</button>
<button onclick="chooseCategory(this,'Telugu movie official trailer')">Telugu</button>
<button onclick="chooseCategory(this,'Hindi movie official trailer')">Hindi</button>
<button onclick="chooseCategory(this,'English movie official trailer')">English</button>
<button onclick="chooseCategory(this,'Marvel official trailer')">Marvel</button>
</div>
</section>

<section id="playerBox">
<h2 id="playingTitle">Now Playing</h2>
<iframe id="videoPlayer" class="player" title="YouTube video player"
allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
<p class="note">Only videos that allow embedding can play here.</p>
<button onclick="openCurrentVideo()">Open on YouTube</button>
</section>

<section id="movies">
<h2 id="resultsTitle">Movie Search Results</h2>
<p id="status">Open API Settings, add your YouTube Data API v3 key, then tap Save & Test.</p>
<div class="grid" id="results"></div>
</section>

<section id="watchlist">
<h2>My Watchlist ❤️</h2>
<div class="grid" id="saved"></div>
</section>

<footer class="footer">
<p>Made with ❤️ by Sudarsanan K R</p>
<p>© 2026 FADS. All Rights Reserved.</p>
</footer>

<div class="modal" id="settings">
<div class="modal-content">
<button class="close" onclick="closeSettings()">CLOSE</button>
<h2>YouTube API Settings</h2>
<p class="note">Paste your YouTube Data API v3 key below. Your key is saved only in this browser.</p>
<label>YouTube API Key</label>
<input id="apiKey" type="password" placeholder="Paste API key here">
<div class="modal-actions">
<button id="saveTestBtn" onclick="saveAndTest()">SAVE & TEST</button>
<button class="secondary" onclick="toggleKey()">SHOW / HIDE</button>
<button class="secondary" onclick="clearKey()">REMOVE KEY</button>
</div>
<p id="testStatus" class="note"></p>
<div class="help">
<strong>Important setup</strong>
<ol>
<li>Enable YouTube Data API v3 in Google Cloud.</li>
<li>After publishing, add https://sudarsanankr.github.io/* to website restrictions.</li>
<li>For API restrictions, select only YouTube Data API v3.</li>
<li>A downloaded local HTML file may send a null referrer.</li>
</ol>
</div>
<p class="note">Standard YouTube Data API quota generally does not require billing. Browser API keys can be visible to visitors, so keep restrictions enabled.</p>
<button class="secondary" onclick="closeSettings()">DONE</button>
</div>
</div>

<script>
let apiKey=localStorage.getItem('fads_api_key')||'';
let currentVideo='';
let watchlist=[];
try{
watchlist=JSON.parse(localStorage.getItem('fads_watchlist')||'[]');
if(!Array.isArray(watchlist))watchlist=[];
}catch(e){watchlist=[]}

const $=id=>document.getElementById(id);

function setStatus(msg,type=''){
$('status').textContent=msg;
$('status').className=type;
}

function openSettings(){
$('settings').style.display='block';
$('apiKey').value=apiKey;
$('testStatus').textContent='';
}
function closeSettings(){$('settings').style.display='none'}
function toggleKey(){
$('apiKey').type=$('apiKey').type==='password'?'text':'password';
}
function clearKey(){
apiKey='';
localStorage.removeItem('fads_api_key');
$('apiKey').value='';
$('testStatus').textContent='API key removed.';
setStatus('Add a valid YouTube API key in API Settings.');
}

function explainApiError(reason){
const s=String(reason||'').toLowerCase();
if(s.includes('referer')||s.includes('referrer'))
return 'Website restriction blocked this request. Publish FADS on GitHub Pages and allow https://sudarsanankr.github.io/* in API key restrictions.';
if(s.includes('keyinvalid')||s.includes('api key not valid'))
return 'Invalid API key. Check the key and Google Cloud project.';
if(s.includes('accessnotconfigured')||s.includes('disabled'))
return 'YouTube Data API v3 is not enabled. Enable it in APIs & Services → Library.';
if(s.includes('quota')||s.includes('dailylimit'))
return 'YouTube API daily quota exceeded. Try again after quota resets.';
if(s.includes('blocked'))
return 'Google Cloud API key restrictions are blocking this request.';
return reason||'Unknown API error. Check Google Cloud settings.';
}

async function requestYouTube(q,max=1){
const url='https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&maxResults='+max+'&q='+encodeURIComponent(q)+'&key='+encodeURIComponent(apiKey);
const response=await fetch(url);
let data={};
try{data=await response.json()}catch(e){}
if(!response.ok){
let detail=data.error?.errors?.[0]?.reason||data.error?.message||('HTTP '+response.status);
throw new Error(explainApiError(detail));
}
return data;
}

async function saveAndTest(){
const key=$('apiKey').value.trim();
if(!key){
$('testStatus').textContent='Please paste your API key first.';
return;
}
apiKey=key;
localStorage.setItem('fads_api_key',key);
$('saveTestBtn').disabled=true;
$('testStatus').textContent='Testing API key...';
try{
await requestYouTube('official movie trailer',1);
$('testStatus').textContent='Success! API key is working. You can now search movies.';
$('testStatus').className='status-ok';
setStatus('API key tested successfully. Search for a movie now.','status-ok');
}catch(e){
$('testStatus').textContent='Test failed: '+e.message;
$('testStatus').className='status-error';
setStatus('API test failed. Review the error in API Settings.','status-error');
}finally{$('saveTestBtn').disabled=false;}
}

function chooseCategory(btn,q){
$('searchInput').value=q;
document.querySelectorAll('.categories button').forEach(b=>b.classList.remove('active'));
btn.classList.add('active');
if(q)searchVideos();
}

async function searchVideos(){
const q=$('searchInput').value.trim();
if(!apiKey){openSettings();return;}
if(!q){setStatus('Enter a movie, actor or trailer name.');return;}
$('searchBtn').disabled=true;
setStatus('Searching YouTube...');
$('results').replaceChildren();
try{
const d=await requestYouTube(q,24);
if(!d.items||!d.items.length){
setStatus('No videos found. Try another search phrase.');
return;
}
setStatus(d.items.length+' videos found.','status-ok');
d.items.forEach(it=>{
const id=it.id?.videoId;
if(!id)return;
const title=it.snippet?.title||'Untitled video';
const thumb=it.snippet?.thumbnails?.high?.url||it.snippet?.thumbnails?.medium?.url||it.snippet?.thumbnails?.default?.url||'';
const card=document.createElement('article');
card.className='movie';
const img=document.createElement('img');
img.src=thumb;img.alt=title;img.loading='lazy';
const info=document.createElement('div');
info.className='movie-info';
const h=document.createElement('h3');h.textContent=title;
const p=document.createElement('p');p.textContent=it.snippet?.channelTitle||'';
const play=document.createElement('button');
play.textContent='▶ PLAY';
play.onclick=()=>playVideo(id,title);
const save=document.createElement('button');
save.textContent='♡ SAVE';
save.className='secondary';
save.style.marginLeft='5px';
save.onclick=()=>addToWatchlist({id,title,thumb});
info.append(h,p,play,save);
card.append(img,info);
$('results').append(card);
});
}catch(e){
setStatus('Error: '+e.message,'status-error');
}finally{$('searchBtn').disabled=false;}
}

function playVideo(id,title){
currentVideo=id;
$('playingTitle').textContent=title;
$('videoPlayer').src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(id)+'?autoplay=1&rel=0&playsinline=1';
$('playerBox').style.display='block';
$('playerBox').scrollIntoView({behavior:'smooth'});
}

function openCurrentVideo(){
if(currentVideo)window.open('https://www.youtube.com/watch?v='+encodeURIComponent(currentVideo),'_blank','noopener');
}

function addToWatchlist(m){
if(!watchlist.some(x=>x.id===m.id)){
watchlist.push(m);
localStorage.setItem('fads_watchlist',JSON.stringify(watchlist));
showWatchlist();
}
}

function showWatchlist(){
const box=$('saved');
box.replaceChildren();
watchlist.forEach(m=>{
const c=document.createElement('article');
c.className='movie';
const im=document.createElement('img');
im.src=m.thumb||'';im.alt=m.title||'';
const info=document.createElement('div');
info.className='movie-info';
const h=document.createElement('h3');
h.textContent=m.title||'Saved video';
const b=document.createElement('button');
b.textContent='▶ PLAY';
b.onclick=()=>playVideo(m.id,m.title);
const remove=document.createElement('button');
remove.textContent='REMOVE';
remove.className='secondary';
remove.style.marginLeft='5px';
remove.onclick=()=>{
watchlist=watchlist.filter(x=>x.id!==m.id);
localStorage.setItem('fads_watchlist',JSON.stringify(watchlist));
showWatchlist();
};
info.append(h,b,remove);
c.append(im,info);
box.append(c);
});
}

$('searchInput').addEventListener('keydown',e=>{
if(e.key==='Enter')searchVideos();
});
showWatchlist();
</script>
</body>
</html>